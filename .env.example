# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs that get admin access (use @userinfobot to find yours)
ADMIN_IDS=

# SQLite database path (default: bot.db in cwd)
DB_PATH=bot.db

# Telegram username for the "Support" button (without the @). Default: demo_support
SUPPORT_USERNAME=demo_support

# City where in-person pickup is offered. Default: Amsterdam
PICKUP_CITY=Amsterdam
